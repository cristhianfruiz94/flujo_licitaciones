# Copie este archivo a .env y complete solo las integraciones que vaya a usar.
# .env está en .gitignore: nunca suba credenciales al repositorio.

# --- Correo de alertas (IMAP) · flag --imap
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# --- API del agregador de licitaciones · flag --api
LICITACIONES_API_BASE_URL=
LICITACIONES_API_EMAIL=
LICITACIONES_API_PASSWORD=
LICITACIONES_API_PERFIL=

# --- LLM vía OpenRouter · flag --llm
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-4.1

# --- Microsoft Teams (webhook del canal de alertas)
TEAMS_WEBHOOK_URL=

# --- Formulario de anexos y umbral
FORM_ANEXOS_URL=https://ejemplo.invalid/webhook/cargar-anexos
UMBRAL_ALERTA=80
